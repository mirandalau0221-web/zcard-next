{
  "version": 1,
  "groups": [
    {
      "id": "appearance",
      "label": "風格與背景",
      "fields": [
        {
          "key": "theme.primary_color",
          "label": "主題色",
          "type": "color",
          "default": "#2563eb"
        },
        {
          "key": "theme.content_width",
          "label": "電腦內容寬度",
          "type": "number",
          "default": 1120,
          "min": 960,
          "max": 1600,
          "help": "單位 px；手機自動適配屏幕"
        },
        {
          "key": "theme.font_size",
          "label": "正文字號",
          "type": "number",
          "default": 14,
          "min": 12,
          "max": 20
        },
        {
          "key": "theme.card_radius",
          "label": "卡片圓角",
          "type": "number",
          "default": 12,
          "min": 0,
          "max": 32
        },
        {
          "key": "template.bg_image",
          "label": "電腦背景圖",
          "type": "image",
          "default": "",
          "help": "推薦寬 1920 px × 高 1080 px（16:9）；背景鋪滿屏幕時可能裁切，重要內容請居中。移除後需點擊「發佈生效」；電腦和手機背景都留空時使用默認純色背景。"
        },
        {
          "key": "template.bg_image_mobile",
          "label": "手機背景圖",
          "type": "image",
          "default": "",
          "help": "建議上傳豎版圖片；留空時沿用電腦背景圖。若要徹底移除背景，請同時清空電腦與手機背景並點擊「發佈生效」。"
        }
      ]
    },
    {
      "id": "catalog",
      "label": "首頁與商品",
      "fields": [
        {
          "key": "template.default_view",
          "label": "商品默認視圖",
          "type": "select",
          "default": "grid",
          "options": [
            {
              "value": "grid",
              "label": "網格"
            },
            {
              "value": "list",
              "label": "列表"
            },
            {
              "value": "big",
              "label": "大圖"
            }
          ]
        },
        {
          "key": "template.category_nav_style",
          "label": "分類導航樣式",
          "type": "select",
          "default": "list",
          "options": [
            {
              "value": "list",
              "label": "側欄列表"
            },
            {
              "value": "grid",
              "label": "分類網格"
            }
          ]
        },
        {
          "key": "template.per_row",
          "label": "電腦每行商品數",
          "type": "number",
          "default": 4,
          "min": 2,
          "max": 8
        },
        {
          "key": "template.per_page",
          "label": "每頁 / 每批商品數",
          "type": "number",
          "default": 20,
          "min": 1,
          "max": 100
        },
        {
          "key": "template.sort_by",
          "label": "默認排序",
          "type": "select",
          "default": "default",
          "options": [
            {
              "value": "default",
              "label": "綜合排序"
            },
            {
              "value": "price_asc",
              "label": "價格從低到高"
            },
            {
              "value": "price_desc",
              "label": "價格從高到低"
            },
            {
              "value": "newest",
              "label": "最新上架"
            },
            {
              "value": "sales",
              "label": "銷量"
            }
          ]
        },
        {
          "key": "template.show_stock",
          "label": "顯示庫存",
          "type": "switch",
          "default": true
        },
        {
          "key": "template.show_sales",
          "label": "顯示銷量",
          "type": "switch",
          "default": true,
          "help": "關閉後隱藏商品列表和詳情中的銷量，同時關閉銷量排序；已有銷量排序鏈接及默認排序將回退為綜合排序。"
        }
      ]
    },
    {
      "id": "notice",
      "label": "公告與文章",
      "fields": [
        {
          "key": "theme.notice_auto",
          "label": "自動彈出公告",
          "type": "switch",
          "default": true
        },
        {
          "key": "theme.notice_width",
          "label": "電腦公告寬度",
          "type": "number",
          "default": 960,
          "min": 480,
          "max": 1280,
          "visible_when": {
            "field": "theme.notice_auto",
            "equals": true
          }
        },
        {
          "key": "theme.article_width",
          "label": "文章正文寬度",
          "type": "number",
          "default": 960,
          "min": 640,
          "max": 1280
        }
      ]
    },
    {
      "id": "navigation",
      "label": "導航入口",
      "fields": [
        {
          "key": "theme.brand_bar_enabled",
          "label": "顯示頂部品牌條",
          "type": "switch",
          "default": true,
          "help": "控制電腦端導航上方的藍色品牌條；關閉後不顯示且不佔位，不影響首頁輪播。手機端保持隱藏。"
        },
        {
          "key": "theme.nav_cart",
          "label": "顯示購物車入口",
          "type": "switch",
          "default": true,
          "capability": "cart",
          "help": "僅控制入口展示；購物車業務需在系統設置中開啓"
        },
        {
          "key": "theme.nav_posts",
          "label": "顯示文章導航",
          "type": "switch",
          "default": true
        },
        {
          "key": "theme.back_top",
          "label": "顯示返回頂部",
          "type": "switch",
          "default": true
        }
      ]
    },
    {
      "id": "footer_services",
      "label": "頁腳服務",
      "fields": [
        {
          "key": "theme.footer_service_1_icon",
          "label": "第 1 項 · 圖標",
          "type": "text",
          "default": "⚡",
          "help": "填寫 Emoji 或簡短符號；設置圖標圖片後優先顯示圖片。"
        },
        {
          "key": "theme.footer_service_1_image",
          "label": "第 1 項 · 圖標圖片",
          "type": "image",
          "default": "",
          "help": "可從素材庫選擇或上傳圖片；留空使用上方圖標，圖片加載失敗時也會回落到圖標。"
        },
        {
          "key": "theme.footer_service_1_title",
          "label": "第 1 項 · 標題",
          "type": "text",
          "default": "按商品履約"
        },
        {
          "key": "theme.footer_service_1_description",
          "label": "第 1 項 · 説明",
          "type": "text",
          "default": "虛擬交付或快遞配送"
        },
        {
          "key": "theme.footer_service_2_icon",
          "label": "第 2 項 · 圖標",
          "type": "text",
          "default": "🛡️",
          "help": "填寫 Emoji 或簡短符號；設置圖標圖片後優先顯示圖片。"
        },
        {
          "key": "theme.footer_service_2_image",
          "label": "第 2 項 · 圖標圖片",
          "type": "image",
          "default": "",
          "help": "可從素材庫選擇或上傳圖片；留空使用上方圖標，圖片加載失敗時也會回落到圖標。"
        },
        {
          "key": "theme.footer_service_2_title",
          "label": "第 2 項 · 標題",
          "type": "text",
          "default": "正品保障"
        },
        {
          "key": "theme.footer_service_2_description",
          "label": "第 2 項 · 説明",
          "type": "text",
          "default": "渠道直供貨源"
        },
        {
          "key": "theme.footer_service_3_icon",
          "label": "第 3 項 · 圖標",
          "type": "text",
          "default": "💬",
          "help": "填寫 Emoji 或簡短符號；設置圖標圖片後優先顯示圖片。"
        },
        {
          "key": "theme.footer_service_3_image",
          "label": "第 3 項 · 圖標圖片",
          "type": "image",
          "default": "",
          "help": "可從素材庫選擇或上傳圖片；留空使用上方圖標，圖片加載失敗時也會回落到圖標。"
        },
        {
          "key": "theme.footer_service_3_title",
          "label": "第 3 項 · 標題",
          "type": "text",
          "default": "在線客服"
        },
        {
          "key": "theme.footer_service_3_description",
          "label": "第 3 項 · 説明",
          "type": "text",
          "default": "7×24 小時響應"
        },
        {
          "key": "theme.footer_service_4_icon",
          "label": "第 4 項 · 圖標",
          "type": "text",
          "default": "↩️",
          "help": "填寫 Emoji 或簡短符號；設置圖標圖片後優先顯示圖片。"
        },
        {
          "key": "theme.footer_service_4_image",
          "label": "第 4 項 · 圖標圖片",
          "type": "image",
          "default": "",
          "help": "可從素材庫選擇或上傳圖片；留空使用上方圖標，圖片加載失敗時也會回落到圖標。"
        },
        {
          "key": "theme.footer_service_4_title",
          "label": "第 4 項 · 標題",
          "type": "text",
          "default": "售後無憂"
        },
        {
          "key": "theme.footer_service_4_description",
          "label": "第 4 項 · 説明",
          "type": "text",
          "default": "問題訂單快速處理"
        }
      ]
    }
  ]
}
